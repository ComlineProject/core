use std::validators::StringBounds

struct Mail {
    sender: string
    recipient: string
}

struct Article {
    title: string
    content: string
}

// Maximum amount of articles that a provider can send
const SENT_ARTICLES_MAX: u8 = 10

protocol MailService {
    function send(Mail);
}

protocol Feed {
    // Fetches new articles since last fetch
    function fetch_articles() -> Article[];
}
