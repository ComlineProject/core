const AGREEMENT_KEY: string = "agreement_key"

struct Credentials {
    username: str
    password: str
}

struct CredentialsOther {
    username: str
    password: str
}

enum RegisterStatus {
    Ok
    UsernameTaken
}

protocol Registry {
    function register(Credentials) -> RegisterStatus;
    function my_username() -> str;
    function tell_back(str) -> str;
}

struct TellBackResponse {
}

protocol Events {
    function poke();
}
