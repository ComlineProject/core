const AGREEMENT_KEY: string = "agreement_key"

struct Credentials {
    username: string
    password: string
}

struct CredentialsOther {
    username: string
    password: string
}

enum RegisterStatus {
    Ok
    UsernameTaken
}

protocol Registry {
    function register(Credentials) -> RegisterStatus;
    function my_username() -> string;
    function tell_back(string) -> string;
}

struct TellBackResponse {
}

protocol Events {
    function poke();
}
