// Constants are immutable values that exist permanently in schema types,
// useful for universal references
const WORLD_COUNT: u8 = 10

// A basic message structure with an optional field
struct MessageVersioned {
    optional world_name: string
    person_name: string
}

// A basic message structure without optional fields
struct Message {
    world_name: string
}

// Protocol definition that can be used for RPC, IPC or anything of the likes
protocol World {
    // One-way call, no return
    function hello();

    // One-way call, single return
    function hello_back() -> string;

    // Two-way call, both sides can call this, and it returns a value
    function hello_back_both() -> string;
}
