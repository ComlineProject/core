                        "code": "settings::forbidden",
                        "severity": "error"
                    }
                ]
            }
        },
        {
            "id": "package/adds-bounded-size",
            "description": "a marker says why for bounded_size, which the package can't; the package says the rest",
            "packages": [
                {
                    "name": "app",
                    "config": "congregation app\nspecification_version = 1\nhandshake = \"none\"\nunverified = {\n    schema_agreement = \"the gateway pins schemas by contract\"\n    encoding_agreement = \"the gateway pins schemas by contract\"\n}\nsettings = { annotations = { unverified = { allowed = true } } }\n",
                    "schemas": [
                        {
                            "path": "src/api.ids",
                            "text": "@unverified = { bounded_size = \"the uploader streams whatever it's given\" }\nprotocol P {\n    function put(s: string);\n}\n"
                        }
                    ],
                    "dependencies": []
                }
            ],
            "build": "app",
            "expect": {
                "protocols": [
                    {
                        "name": "P",
                        "given_up": [
                            "schema_agreement",
                            "encoding_agreement",
                            "bounded_size"
                        ],
                        "acknowledged": [
                            {
                                "guarantee": "schema_agreement",
                                "scope": "package",
                                "reason": "the gateway pins schemas by contract"
                            },
                            {
                                "guarantee": "encoding_agreement",
                                "scope": "package",
                                "reason": "the gateway pins schemas by contract"
                            },
                            {
                                "guarantee": "bounded_size",
                                "scope": "protocol",
                                "reason": "the uploader streams whatever it's given"
                            }
                        ]
                    }
                ],
                "builds": true,
                "diagnostics": [
                    {
                        "code": "unverified::schema-agreement",
                        "severity": "warning"
                    },
                    {
                        "code": "unverified::encoding-agreement",
                        "severity": "warning"
                    },
                    {
                        "code": "unverified::bounded-size",
                        "severity": "warning"
                    }
                ]
            }
        },
        {
            "id": "package/bounded-size-not-covered",
            "description": "the package covering the handshake doesn't cover an unbounded string",
            "packages": [
                {
                    "name": "app",
                    "config": "congregation app\nspecification_version = 1\nhandshake = \"none\"\nunverified = {\n    schema_agreement = \"the gateway pins schemas by contract\"\n    encoding_agreement = \"the gateway pins schemas by contract\"\n}\nsettings = { annotations = { unverified = { allowed = true } } }\n",
                    "schemas": [
                        {
                            "path": "src/api.ids",
                            "text": "protocol P {\n    function put(s: string);\n}\n"
                        }
                    ],
                    "dependencies": []
                }
            ],
            "build": "app",
            "expect": {
                "builds": false,
                "diagnostics": [
                    {
                        "code": "bounds::unbounded",
                        "severity": "error"
                    }
                ]
            }
        }
