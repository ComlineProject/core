        {
            "id": "imports/unknown-first-segment",
            "description": "a bare path that is neither a dependency, std nor one of the package's schemas is unresolved, not this error; the use still brings Blob into scope, so the bare Blob after it is no second error, as in Rust",
            "packages": [
                {
                    "name": "app",
                    "config": "congregation app\nspecification_version = 1\n",
                    "schemas": [
                        {
                            "path": "src/models.ids",
                            "text": "struct Blob {\n    size: u32\n}\n\nstruct Tag {\n    id: u32\n}\n"
                        },
                        {
                            "path": "src/api.ids",
                            "text": "use modles::Blob\n\nstruct Upload {\n    blob: Blob\n}\n"
                        }
                    ],
                    "dependencies": []
                }
            ],
            "build": "app",
            "expect": {
                "builds": false,
                "diagnostics": [
                    {
                        "code": "import::unresolved",
                        "severity": "error"
                    }
                ]
            }
        },
        {
            "id": "imports/own-schema-named-like-dependency",
            "description": "a package's own schema named like one of its dependencies is refused, so a first segment is never both",
            "packages": [
                {
                    "name": "models",
                    "config": "congregation models\nspecification_version = 1\n",
                    "schemas": [
                        {
                            "path": "src/api.ids",
                            "text": "struct Blob {\n    size: u32\n}\n\nstruct Tag {\n    id: u32\n}\n"
                        }
                    ],
                    "dependencies": []
                },
                {
                    "name": "app",
                    "config": "congregation app\nspecification_version = 1\ndependencies = {\n    models = {\n        path = \"../models\"\n    }\n}\n",
                    "schemas": [
                        {
                            "path": "src/models.ids",
                            "text": "struct Blob {\n    size: u32\n}\n\nstruct Tag {\n    id: u32\n}\n"
                        }
                    ],
                    "dependencies": [
                        {
                            "name": "models"
                        }
                    ]
                }
            ],
            "build": "app",
            "expect": {
                "builds": false,
                "diagnostics": [],
                "error_contains": [
                    "schema 'models.ids' is named like the dependency 'models'"
                ]
            }
        },
