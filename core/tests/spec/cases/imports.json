        {
            "id": "imports/dependency-path",
            "description": "a bare path whose first segment is a dependency reaches the dependency's schema",
            "packages": [
                {
                    "name": "models",
                    "config": "congregation models\nspecification_version = 1\n",
                    "schemas": [
                        {
                            "path": "src/api.ids",
                            "text": "struct Blob {\n    size: u32\n}\n\nstruct Tag {\n    id: u32\n}\n"
                        }
                    ],
                    "dependencies": []
                },
                {
                    "name": "app",
                    "config": "congregation app\nspecification_version = 1\ndependencies = {\n    models = {\n        path = \"../models\"\n    }\n}\n",
                    "schemas": [
                        {
                            "path": "src/api.ids",
                            "text": "use models::api::Blob\n\nstruct Upload {\n    blob: Blob\n}\n"
                        }
                    ],
                    "dependencies": [
                        {
                            "name": "models"
                        }
                    ]
                }
            ],
            "build": "app",
            "expect": {
                "protocols": [],
                "builds": true,
                "diagnostics": []
            }
