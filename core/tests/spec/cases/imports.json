{
    "$schema": "../../specs/gen/compiler.schema.json",
    "group": "imports",
    "cases": [
        {
            "id": "imports/bare-own-item",
            "description": "a bare path to an item of the package's own schema is an error",
            "packages": [
                {
                    "name": "app",
                    "config": "congregation app\nspecification_version = 1\n",
                    "schemas": [
                        {
                            "path": "src/models.ids",
                            "text": "struct Blob {\n    size: u32\n}\n\nstruct Tag {\n    id: u32\n}\n"
                        },
                        {
                            "path": "src/api.ids",
                            "text": "use models::Blob\n\nstruct Upload {\n    blob: Blob\n}\n"
                        }
                    ],
                    "dependencies": []
                }
            ],
            "build": "app",
            "expect": {
                "builds": false,
                "diagnostics": [
                    {
                        "code": "import::bare-own-schema-path",
                        "severity": "error"
                    }
                ]
            }
        },
        {
            "id": "imports/bare-own-namespace",
            "description": "a bare path to the package's own schema as a whole is an error, and so is the bare Blob after it, as a whole-namespace use brings in only its name: every error is reported",
            "packages": [
                {
                    "name": "app",
                    "config": "congregation app\nspecification_version = 1\n",
                    "schemas": [
                        {
                            "path": "src/models.ids",
                            "text": "struct Blob {\n    size: u32\n}\n\nstruct Tag {\n    id: u32\n}\n"
                        },
                        {
                            "path": "src/api.ids",
                            "text": "use models\n\nstruct Upload {\n    blob: Blob\n}\n"
                        }
                    ],
                    "dependencies": []
                }
            ],
            "build": "app",
            "expect": {
                "builds": false,
                "diagnostics": [
                    {
                        "code": "import::bare-own-schema-path",
                        "severity": "error"
                    },
                    {
                        "code": "reference::not-in-scope",
                        "severity": "error"
                    }
                ]
            }
        },
